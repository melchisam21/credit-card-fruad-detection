# Environment variables — copy this file to .env and fill in real values.
# Never commit .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Credit Card Fraud Detection API"
APP_VERSION="1.0.0"
DEBUG=false

# ── Inference ─────────────────────────────────────────────────────────────────
# Threshold above which a transaction is flagged as fraudulent (0.0 – 1.0)
FRAUD_THRESHOLD=0.7
